=\n","# IMPORT LIBRARIES\n","# ==========================================\n","\n","import streamlit as st\n","import pandas as pd\n","import plotly.express as px\n","\n","\n","# ==========================================\n","# PAGE CONFIGURATION\n","# ==========================================\n","\n","st.set_page_config(\n","    page_title=\"Business Dashboard\",\n","    layout=\"wide\"\n",")\n","\n","\n","# ==========================================\n","# LOAD DATASET\n","# ==========================================\n","\n","df = pd.read_csv(\"Global_Superstore.csv\")\n","\n","\n","# ==========================================\n","# SIDEBAR FILTERS\n","# ==========================================\n","\n","st.sidebar.header(\"FILTERS\")\n","\n","# Region filter\n","region = st.sidebar.multiselect(\n","    \"Select Region\",\n","    options=df[\"Region\"].unique(),\n","    default=df[\"Region\"].unique()\n",")\n","\n","# Category filter\n","category = st.sidebar.multiselect(\n","    \"Select Category\",\n","    options=df[\"Category\"].unique(),\n","    default=df[\"Category\"].unique()\n",")\n","\n","# Sub-Category filter\n","subcategory = st.sidebar.multiselect(\n","    \"Select Sub-Category\",\n","    options=df[\"Sub-Category\"].unique(),\n","    default=df[\"Sub-Category\"].unique()\n",")\n","\n","\n","# ==========================================\n","# FILTER DATA\n","# ==========================================\n","\n","filtered_df = df[\n","    (df[\"Region\"].isin(region)) &\n","    (df[\"Category\"].isin(category)) &\n","    (df[\"Sub-Category\"].isin(subcategory))\n","]\n","\n","\n","# ==========================================\n","# DASHBOARD TITLE\n","# ==========================================\n","\n","st.title(\"Interactive Business Dashboard\")\n","\n","\n","# ==========================================\n","# KPI CALCULATIONS\n","# ==========================================\n","\n","total_sales = filtered_df[\"Sales\"].sum()\n","\n","total_profit = filtered_df[\"Profit\"].sum()\n","\n","top_customers = (\n","    filtered_df.groupby(\"Customer Name\")[\"Sales\"]\n","    .sum()\n","    .sort_values(ascending=False)\n","    .head(5)\n",")\n","\n","\n","# ==========================================\n","# DISPLAY KPIs\n","# ==========================================\n","\n","col1, col2 = st.columns(2)\n","\n","with col1:\n","    st.metric(\"Total Sales\", f\"${total_sales:,.2f}\")\n","\n","with col2:\n","    st.metric(\"Total Profit\", f\"${total_profit:,.2f}\")\n","\n","\n","# ==========================================\n","# SALES BY CATEGORY\n","# ==========================================\n","\n","sales_chart = px.bar(\n","    filtered_df,\n","    x=\"Category\",\n","    y=\"Sales\",\n","    color=\"Category\",\n","    title=\"Sales by Category\"\n",")\n","\n","st.plotly_chart(sales_chart, use_container_width=True)\n","\n","\n","# ==========================================\n","# PROFIT BY REGION\n","# ==========================================\n","\n","profit_chart = px.bar(\n","    filtered_df,\n","    x=\"Region\",\n","    y=\"Profit\",\n","    color=\"Region\",\n","    title=\"Profit by Region\"\n",")\n","\n","st.plotly_chart(profit_chart, use_container_width=True)\n","\n","\n","# ==========================================\n","# TOP 5 CUSTOMERS\n","# ==========================================\n","\n","top_customer_chart = px.bar(\n","    top_customers,\n","    x=top_customers.values,\n","    y=top_customers.index,\n","    orientation='h',\n","    title=\"Top 5 Customers by Sales\"\n",")\n","\n","st.plotly_chart(top_customer_chart, use_container_width=True)\n","\n","\n","# ==========================================\n","# SALES TREND\n","# ==========================================\n","\n","if \"Order Date\" in filtered_df.columns:\n","\n","    filtered_df[\"Order Date\"] = pd.to_datetime(\n","        filtered_df[\"Order Date\"]\n","    )\n","\n","    sales_trend = (\n","        filtered_df.groupby(\"Order Date\")[\"Sales\"]\n","        .sum()\n","        .reset_index()\n","    )\n","\n","    line_chart = px.line(\n","        sales_trend,\n","        x=\"Order Date\",\n","        y=\"Sales\",\n","        title=\"Sales Trend Over Time\"\n","    )\n","\n","    st.plotly_chart(line_chart, use_container_width=True)\n","\n","\n","# ==========================================\n","# DATA PREVIEW\n","# ==========================================\n","\n","st.subheader(\"Dataset Preview\")\n","\n","st.dataframe(filtered_df.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Wmkiot72Fx2A","executionInfo":{"status":"ok","timestamp":1779695177235,"user_tz":420,"elapsed":80,"user":{"displayName":"Miral Ahmad Khan","userId":"03618487170798371311"}},"outputId":"23ad0ed6-d889-4cba-92ac-4212a376fdad"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing app.py\n"]}]},{"cell_type":"markdown","source":["Step 8"],"metadata":{"id":"cAV3RyMKGWIi"}},{"cell_type":"code","source":["# ==========================================\n","# RUN STREAMLIT APP\n","# ==========================================\n","\n","!streamlit run app.py &>/content/logs.txt &"],"metadata":{"id":"Wg1Z0kq3GUxB","executionInfo":{"status":"ok","timestamp":1779695229814,"user_tz":420,"elapsed":113,"user":{"displayName":"Miral Ahmad Khan","userId":"03618487170798371311"}}},"execution_count":9,"outputs":[]},{"cell_type":"markdown","source":["# Conclusion\n","\n","In this project, an interactive business intelligence dashboard was developed using Streamlit.\n","\n","The dashboard provided:\n","\n","* Interactive filtering\n","* KPI analysis\n","* Sales and profit visualization\n","* Customer performance insights\n","\n","The project demonstrated practical applications of:\n","\n","* Business Intelligence\n","* Dashboard Development\n","* Data Storytelling\n","* Interactive Data Visualization\n"],"metadata":{"id":"pNu6-0lLGini"}},{"cell_type":"code","source":[],"metadata":{"id":"l-